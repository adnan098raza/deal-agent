# Copy to .env and fill in. Never commit .env.

# ---- LLM (pick one provider; leave key empty to use the built-in heuristic scorer) ----
LLM_PROVIDER=groq                 # groq | gemini | none
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- ntfy.sh push ----
NTFY_ENABLED=true
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=                       # pick a long, hard-to-guess topic name
NTFY_TOKEN=                       # optional, for protected topics / self-hosted
# Button presses (Snooze / Not interested) go to this topic; default: <NTFY_TOPIC>-fb
NTFY_FEEDBACK_TOPIC=
# PC tells the GitHub Actions fallback it is online (posts to <NTFY_TOPIC>-hb hourly)
HEARTBEAT_ENABLED=false

# ---- Email (SMTP): end-of-day report at 21:00 ----
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587                     # 587 = STARTTLS, 465 = SSL
SMTP_USER=you@example.com
SMTP_PASSWORD=                    # for Gmail use an App Password
EMAIL_FROM=you@example.com
EMAIL_TO=you@example.com          # comma-separated for several recipients

# ---- Dashboard ----
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1          # 0.0.0.0 = reachable from your phone on Wi-Fi (requires DASHBOARD_TOKEN)
DASHBOARD_PORT=8765
DASHBOARD_TOKEN=

# ---- Files ----
# DB_PATH defaults to %LOCALAPPDATA%/DealAgent/deals.db (kept OUT of OneDrive on purpose).
# DB_PATH=
EXCEL_PATH=data/deals.xlsx        # inside the project's OneDrive folder -> syncs to your phone
# LOG_FILE defaults to %LOCALAPPDATA%/DealAgent/agent.log
PREFERENCES_FILE=preferences.yaml
SOURCES_FILE=sources.yaml
WATCHLIST_FILE=watchlist.yaml

# ---- Misc ----
USER_AGENT=DealAgent/1.0 (personal deal watcher)
LOG_LEVEL=INFO
TIMEZONE=Europe/Berlin
